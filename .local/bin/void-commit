#!/usr/bin/env bash

set -e

cd /home/cid/project/void-packages || {
    echo "❌ Folder void-packages tidak ditemukan"
    exit 1
}

sync_upstream() {
    echo "🔄 Syncing master dari upstream..."

    git checkout master || {
        echo "❌ Gagal checkout ke master"
        exit 1
    }

    if [[ "$1" == "--keep" ]]; then
        echo "🛑 Lewatkan stash karena --keep dipakai"
    else
        echo "📦 Menyimpan perubahan lokal ke stash..."
        git stash push -m "void-commit-auto-stash" || true
    fi

    git fetch upstream
    git reset --hard upstream/master
    git clean -fd
    git push origin master --force   # <== Penting agar GitHub tidak behind

    echo "✅ master disamakan dengan upstream/master"
}

commit_changes() {
    echo "🔀 Checkout ke branch repo-sendiri..."
    git checkout repo-sendiri

    if git status --porcelain | grep -q '^ M srcpkgs/'; then
        echo "📦 Perubahan srcpkgs/ terdeteksi → auto commit"
        git add srcpkgs/

        COMMIT_MSG=$(basename "$(find srcpkgs -mindepth 2 -maxdepth 2 -type f -name template -newermt '1 minute ago' | head -n1 | xargs dirname 2>/dev/null)")
        [[ -z "$COMMIT_MSG" ]] && COMMIT_MSG="update template"
        git commit -m "$COMMIT_MSG"
    fi

    echo "🔁 Rebase repo-sendiri di atas master..."
    git fetch origin
    git rebase master || {
        echo "❌ Rebase gagal. Selesaikan konflik lalu jalankan ulang."
        exit 1
    }

    LOCAL=$(git rev-parse repo-sendiri)
    REMOTE=$(git rev-parse origin/repo-sendiri)
    BASE=$(git merge-base repo-sendiri origin/repo-sendiri)

    if [[ "$LOCAL" != "$REMOTE" ]]; then
        echo "📤 Push repo-sendiri ke origin..."
        if [[ "$BASE" != "$REMOTE" ]]; then
            echo "🔁 Divergen → push dengan force-with-lease"
            git push --force-with-lease origin repo-sendiri
        else
            git push origin repo-sendiri
        fi
    else
        echo "✅ Branch repo-sendiri sudah identik dengan origin, skip push."
    fi

    echo "✅ Selesai!"
}

restore_stash() {
    if git stash list | grep -q "void-commit-auto-stash"; then
        echo "📤 Mengembalikan perubahan lokal dari stash..."
        git stash pop
    fi
}

case "$1" in
    --commit)
        commit_changes
        ;;
    --keep)
        sync_upstream --keep
        commit_changes
        ;;
    *)
        sync_upstream
        commit_changes
        restore_stash
        ;;
esac

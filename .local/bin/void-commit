#!/bin/bash
set -euo pipefail

cd /home/cid/project/void-packages

echo "🔄 Syncing master dari upstream..."

# Step 1: Reset master ke upstream/master
git checkout master
git fetch upstream
git reset --hard upstream/master
echo "✅ master disamakan dengan upstream/master"

# Step 2: Push master ke origin supaya GitHub tahu branch ini bersih
git push origin master
echo "📤 master dipush ke origin"

# Step 3: Checkout ke branch kerja
echo "🔀 Pindah ke branch 'repo-sendiri'..."
git checkout repo-sendiri

# Step 4: Rebase commit lokal kamu di atas master yang baru
echo "🔁 Rebase 'repo-sendiri' di atas master..."
git rebase master || {
  echo "❌ Rebase gagal. Selesaikan konflik lalu jalankan ulang void-commit."
  exit 1
}

# Step 5: Commit perubahan srcpkgs/ kalau ada
if git status --porcelain | grep -q '^. srcpkgs/'; then
    echo "📦 Perubahan srcpkgs/ terdeteksi → auto commit"
    git add srcpkgs/
    COMMIT_MSG=$(basename "$(find srcpkgs -mindepth 2 -maxdepth 2 -type f -name template | head -n1 | xargs dirname)")
    git commit -m "update $COMMIT_MSG"
fi

# Step 6: Cek apakah ada commit baru dibanding origin
if git log origin/repo-sendiri..repo-sendiri | grep . >/dev/null; then
    echo "📤 Push repo-sendiri ke origin..."
    git push origin repo-sendiri
else
    echo "✅ Tidak ada commit baru di repo-sendiri, skip push."
fi

echo "✅ Selesai!"
